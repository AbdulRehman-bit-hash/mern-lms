<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Activate your account</title>
  </head>
  <body style="font-family: Arial, sans-serif; background:#f4f4f4; padding: 20px;">
    <div style="max-width:480px;margin:auto;background:#fff;padding:24px;border-radius:8px;">
      <h2>Hi <%= user.name %>,</h2>
      <p>Welcome! Use the activation code below to verify your account. This code expires in 5 minutes.</p>
      <h1 style="letter-spacing:6px;text-align:center;color:#4f46e5;"><%= activationCode %></h1>
      <p>If you did not request this, please ignore this email.</p>
    </div>
  </body>
</html>
